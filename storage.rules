rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Objects live at recordings/{sessionId}/{uploader}/… where {uploader}
    // is the participant's auth uid ("episodes" for function-produced files,
    // which are written with the Admin SDK and bypass these rules).
    match /recordings/{sessionId}/{uploader}/{allPaths=**} {
      function isHost() {
        return firestore.get(/databases/(default)/documents/sessions/$(sessionId)).data.hostUid
          == request.auth.uid;
      }

      // Studio admins (see /admins in Firestore) — verified email accounts
      // the DMD team trusts to clean up any session's files.
      function isAdmin() {
        return 'email' in request.auth.token
          && request.auth.token.email_verified == true
          && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email));
      }

      // Playback/download for anyone signed in who knows the exact path —
      // paths are only discoverable through Firestore docs, which are
      // room-members-only.
      allow read: if request.auth != null;
      // Participants may only touch their own folder; the host may write or
      // delete anything in their session (recovery, deletion, teardown).
      allow write: if request.auth != null
        && (request.auth.uid == uploader || isHost() || isAdmin());
    }
  }
}
