rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /recordings/{sessionId}/{allPaths=**} {
      // Any signed-in participant (host or anonymous guest) can upload their
      // own take (recorded as per-chunk objects); only signed-in users can
      // read recordings back for playback.
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
