rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /sessions/{sessionId} {
      // The session owner — used to gate destructive operations.
      function isSessionHost() {
        return request.auth != null
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostUid == request.auth.uid;
      }

      // Host creates the session; anyone with the link can read/join it
      // (guests/producers are unauthenticated apart from anonymous auth).
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      match /participants/{uid} {
        // Presence doc per participant, keyed by their auth uid — drives the
        // WebRTC mesh (who to connect to) plus the waiting room (`admission`)
        // and upload visibility (`upload`).
        allow read: if request.auth != null;
        // The host may write any participant doc — that's how admit/deny
        // (and project teardown) work.
        allow write: if isSessionHost();
        // A participant may create their own doc, but can never self-admit…
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.get('admission', 'pending') != 'admitted'
          && request.resource.data.get('admission', 'pending') != 'denied';
        // …and later self-updates may only leave admission untouched or
        // knock again ('pending') — flipping to admitted/denied is host-only.
        allow update: if request.auth != null && request.auth.uid == uid
          && (request.resource.data.get('admission', '') == resource.data.get('admission', '')
              || request.resource.data.get('admission', '') == 'pending');
      }

      match /connections/{pairId} {
        // Per-pair signaling doc for the mesh; pairId has no bearing on auth,
        // any signed-in session participant may read/write it.
        allow read, write: if request.auth != null;

        match /offerCandidates/{candidateId} {
          allow read, create: if request.auth != null;
        }
        match /answerCandidates/{candidateId} {
          allow read, create: if request.auth != null;
        }
      }

      match /episodes/{episodeId} {
        // Host requests an episode by creating the doc; the Cloud Function
        // (Admin SDK, bypasses rules) writes progress/results back onto it.
        allow read: if request.auth != null;
        allow create, delete: if isSessionHost();
      }

      match /recordings/{recId} {
        // Written once a participant's chunk uploads are confirmed complete.
        // Doc IDs are `{uid}_take{n}` so each take is its own record; only
        // the participant who owns the uid prefix may write it, and only the
        // session host (or the owner) may delete it.
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && recId.matches(request.auth.uid + '_take[0-9]+');
        allow delete: if isSessionHost()
          || (request.auth != null && recId.matches(request.auth.uid + '_take[0-9]+'));
      }
    }
  }
}
