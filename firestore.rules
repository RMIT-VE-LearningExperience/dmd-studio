rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /sessions/{sessionId} {
      // The session owner — used to gate destructive operations.
      function isSessionHost() {
        return request.auth != null
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostUid == request.auth.uid;
      }

      // A participant the host has let in (or who self-admitted while
      // auto-admit was on). Guards everything inside a session that only
      // people actually in the room should touch.
      function isAdmitted() {
        return request.auth != null
          && exists(/databases/$(database)/documents/sessions/$(sessionId)/participants/$(request.auth.uid))
          && get(/databases/$(database)/documents/sessions/$(sessionId)/participants/$(request.auth.uid))
            .data.get('admission', '') == 'admitted';
      }

      // When the host enables auto-admit, guests skip the waiting room and
      // may write their own admission as "admitted".
      function autoAdmitOn() {
        return get(/databases/$(database)/documents/sessions/$(sessionId))
          .data.get('settings', {}).get('autoAdmit', false) == true;
      }

      // Invite-only sessions (tutorials with a guest list): a guest's
      // participant doc must carry the key of an invite that exists under
      // /invites — the client gets it by hashing the email they typed.
      // Hosts and producers aren't gated; neither is a rejoin that leaves
      // admission untouched.
      function inviteOnly() {
        return get(/databases/$(database)/documents/sessions/$(sessionId))
          .data.get('inviteOnly', false) == true;
      }
      function guestInviteOk() {
        return !inviteOnly()
          || request.resource.data.get('role', 'guest') != 'guest'
          || (request.resource.data.get('inviteKey', '') is string
              && request.resource.data.get('inviteKey', '') != ''
              && exists(/databases/$(database)/documents/sessions/$(sessionId)/invites/$(request.resource.data.inviteKey)));
      }

      // An admitted producer — allowed to rename other participants, but
      // nothing else that isSessionHost() alone would otherwise gate.
      function isAdmittedProducer() {
        return request.auth != null
          && exists(/databases/$(database)/documents/sessions/$(sessionId)/participants/$(request.auth.uid))
          && get(/databases/$(database)/documents/sessions/$(sessionId)/participants/$(request.auth.uid))
            .data.get('role', '') == 'producer'
          && get(/databases/$(database)/documents/sessions/$(sessionId)/participants/$(request.auth.uid))
            .data.get('admission', '') == 'admitted';
      }

      // Anyone with the invite link may open a specific session (guests are
      // anonymous), but only the host can LIST sessions — without this split
      // any anonymous visitor could enumerate every session in the app.
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.hostUid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      // Only the host mutates the session doc (recording flag, settings,
      // title, schedule, status, archive)…
      allow update: if request.auth != null && resource.data.hostUid == request.auth.uid;
      // …except capture settings (quality, audio-only, auto-admit), which an
      // admitted producer may also adjust — and nothing else on the doc.
      allow update: if isAdmittedProducer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settings']);
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      match /participants/{uid} {
        // Presence doc per participant, keyed by their auth uid — drives the
        // WebRTC mesh (who to connect to) plus the waiting room (`admission`)
        // and upload visibility (`upload`).
        // A participant can always watch their own doc (that's how they wait
        // at the door); seeing everyone requires being host or admitted.
        allow get: if request.auth != null
          && (request.auth.uid == uid || isSessionHost() || isAdmitted());
        allow list: if isSessionHost() || isAdmitted();
        // The host may write any participant doc — that's how admit/deny
        // (and project teardown) work.
        allow write: if isSessionHost();
        // A participant may create their own doc, but can never self-admit
        // (unless the host turned auto-admit on) and never self-deny.
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.get('admission', 'pending') != 'denied'
          && (request.resource.data.get('admission', 'pending') != 'admitted' || autoAdmitOn())
          && guestInviteOk();
        // …and later self-updates may only leave admission untouched, knock
        // again ('pending'), or self-admit under auto-admit — but a denied
        // (removed) participant can't auto-admit themselves back in.
        allow update: if request.auth != null && request.auth.uid == uid
          && (request.resource.data.get('admission', '') == resource.data.get('admission', '')
              || request.resource.data.get('admission', '') == 'pending'
              || (request.resource.data.get('admission', '') == 'admitted'
                  && autoAdmitOn()
                  && resource.data.get('admission', '') != 'denied'
                  && guestInviteOk()));
        // A producer may rename someone else, but touch nothing else on
        // their doc — can't use this to admit, deny, or mute.
        allow update: if isAdmittedProducer()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
      }

      match /invites/{inviteKey} {
        // Guest list for invite-only sessions, keyed by sha256(email). Any
        // signed-in visitor may `get` one doc (that's the email check), but
        // only the host can list or edit — so the list can't be enumerated.
        allow get: if request.auth != null;
        allow list, write: if isSessionHost();
      }

      match /connections/{pairId} {
        // Per-pair signaling docs for the mesh — only people in the room.
        allow read, write: if isSessionHost() || isAdmitted();

        // Delete is allowed so participants can sweep their own dead
        // signaling docs on leave (and the host on project teardown).
        match /offerCandidates/{candidateId} {
          allow read, create, delete: if isSessionHost() || isAdmitted();
        }
        match /answerCandidates/{candidateId} {
          allow read, create, delete: if isSessionHost() || isAdmitted();
        }
      }

      match /scripts/{uid} {
        // Per-participant teleprompter script. The owner manages their own;
        // the host may also write one for a guest (and preps the shared
        // session script under the id "shared"). An admitted producer may
        // run the shared prompter live — edit its text and drive its
        // play/pause controls — but can't touch personal scripts.
        allow read: if request.auth != null
          && (request.auth.uid == uid || isSessionHost() || isAdmitted());
        allow write: if request.auth != null
          && (request.auth.uid == uid || isSessionHost()
              || (uid == 'shared' && isAdmittedProducer()));
      }

      match /chat/{msgId} {
        // Only people in the room read or post; messages are immutable once
        // sent (host teardown deletes the whole collection).
        allow read: if isSessionHost() || isAdmitted();
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && (isSessionHost() || isAdmitted())
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow delete: if isSessionHost();
      }

      match /episodes/{episodeId} {
        // Host requests an episode by creating the doc; the Cloud Function
        // (Admin SDK, bypasses rules) writes progress/results back onto it.
        allow read: if isSessionHost() || isAdmitted();
        allow create, delete: if isSessionHost();
      }

      match /recordings/{recId} {
        // Written from the moment a participant's take starts (uploadState
        // recording → uploading → complete). Doc IDs are `{uid}_take{n}`
        // (or `{uid}_screen_take{n}`) so each track is its own record.
        // These docs carry transcripts — reads are room-members only.
        // The host may also update — that's how a dead participant's
        // partial track gets finalized (uploadState flipped to "complete").
        allow read: if isSessionHost() || isAdmitted();
        allow create, update: if isSessionHost()
          || (request.auth != null
              && recId.matches(request.auth.uid + '(_screen)?_take[0-9]+'));
        allow delete: if isSessionHost()
          || (request.auth != null && recId.matches(request.auth.uid + '(_screen)?_take[0-9]+'));
      }
    }
  }
}
